{
  "comment": [
    "The filter language, as behaviour rather than as SQL. Both implementations read this file: the",
    "server builds the condition and runs it against SQLite, the browser evaluates it in memory.",
    "A case that disagrees means a filter means two different things depending on where it ran.",
    "",
    "kind is text | number | date | boolean, value is what the column holds (null for NULL), and",
    "matches says whether the row survives the filter."
  ],
  "now": "2026-08-23 14:30:00",
  "cases": [
    { "filter": "ada", "kind": "text", "value": "Adam", "matches": true, "why": "a bare word contains, without case" },
    { "filter": "ADA", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "ada", "kind": "text", "value": "Linus", "matches": false },
    { "filter": "ada", "kind": "text", "value": null, "matches": false, "why": "no value contains nothing" },

    { "filter": "^ad", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "^da", "kind": "text", "value": "Adam", "matches": false },
    { "filter": "!^ad", "kind": "text", "value": "Adam", "matches": false },
    { "filter": "!^da", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "$am", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "$ad", "kind": "text", "value": "Adam", "matches": false },
    { "filter": "!$ad", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "+da", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "~da", "kind": "text", "value": "Adam", "matches": false },
    { "filter": "~zz", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "~zz", "kind": "text", "value": null, "matches": true, "why": "a row with no value does not contain zz either" },
    { "filter": "=adam", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "=ada", "kind": "text", "value": "Adam", "matches": false },
    { "filter": "!=ada", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "<>adam", "kind": "text", "value": "Adam", "matches": false },

    { "filter": "NULL", "kind": "text", "value": null, "matches": true },
    { "filter": "NULL", "kind": "text", "value": "Adam", "matches": false },
    { "filter": "NOT NULL", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "NOT NULL", "kind": "text", "value": null, "matches": false },
    { "filter": "EMPTY", "kind": "text", "value": "", "matches": true },
    { "filter": "EMPTY", "kind": "text", "value": null, "matches": true },
    { "filter": "EMPTY", "kind": "text", "value": "Adam", "matches": false },
    { "filter": "NOT EMPTY", "kind": "text", "value": "Adam", "matches": true },
    { "filter": "NOT EMPTY", "kind": "text", "value": "", "matches": false },
    { "filter": "null", "kind": "number", "value": null, "matches": true, "why": "the words are read without case" },

    { "filter": "\"two words\"", "kind": "text", "value": "two words here", "matches": true },
    { "filter": "\"a,b\"", "kind": "text", "value": "a,b", "matches": true, "why": "a comma inside quotes is not an OR" },

    { "filter": "10", "kind": "number", "value": 10, "matches": true, "why": "a bare number equals" },
    { "filter": "10", "kind": "number", "value": 100, "matches": false, "why": "and does not contain" },
    { "filter": ">10", "kind": "number", "value": 11, "matches": true },
    { "filter": ">10", "kind": "number", "value": 10, "matches": false },
    { "filter": ">=10", "kind": "number", "value": 10, "matches": true },
    { "filter": "<10", "kind": "number", "value": 9, "matches": true },
    { "filter": "<=10", "kind": "number", "value": 11, "matches": false },
    { "filter": "!=10", "kind": "number", "value": 11, "matches": true },
    { "filter": "-5", "kind": "number", "value": -5, "matches": true, "why": "a negative number is not an operator" },
    { "filter": "1.5", "kind": "number", "value": 1.5, "matches": true },

    { "filter": ">10 <20", "kind": "number", "value": 15, "matches": true, "why": "whitespace is AND" },
    { "filter": ">10 <20", "kind": "number", "value": 25, "matches": false },
    { "filter": "=1,=2", "kind": "number", "value": 2, "matches": true, "why": "a comma is OR" },
    { "filter": "=1,=2", "kind": "number", "value": 3, "matches": false },
    { "filter": ">10 <20,=0", "kind": "number", "value": 0, "matches": true, "why": "OR binds looser than AND" },
    { "filter": ">10 <20,=0", "kind": "number", "value": 15, "matches": true },
    { "filter": ">10 <20,=0", "kind": "number", "value": 5, "matches": false },

    { "filter": "true", "kind": "boolean", "value": true, "matches": true },
    { "filter": "false", "kind": "boolean", "value": true, "matches": false },
    { "filter": "1", "kind": "boolean", "value": true, "matches": true },
    { "filter": "0", "kind": "boolean", "value": false, "matches": true },

    { "filter": "TODAY", "kind": "date", "value": "2026-08-23 09:00:00", "matches": true },
    { "filter": "TODAY", "kind": "date", "value": "2026-08-22 23:59:59", "matches": false },
    { "filter": "YESTERDAY", "kind": "date", "value": "2026-08-22 23:59:59", "matches": true },
    { "filter": "TOMORROW", "kind": "date", "value": "2026-08-24 00:00:00", "matches": true },
    { "filter": "THIS WEEK", "kind": "date", "value": "2026-08-17 00:00:00", "matches": true, "why": "the week starts on Monday" },
    { "filter": "THIS WEEK", "kind": "date", "value": "2026-08-16 23:00:00", "matches": false },
    { "filter": "LAST WEEK", "kind": "date", "value": "2026-08-16 23:00:00", "matches": true },
    { "filter": "THIS MONTH", "kind": "date", "value": "2026-08-01 00:00:00", "matches": true },
    { "filter": "THIS MONTH", "kind": "date", "value": "2026-07-31 23:59:59", "matches": false },
    { "filter": "LAST MONTH", "kind": "date", "value": "2026-07-31 23:59:59", "matches": true },
    { "filter": "NEXT MONTH", "kind": "date", "value": "2026-09-15 12:00:00", "matches": true },
    { "filter": "THIS YEAR", "kind": "date", "value": "2026-01-01 00:00:00", "matches": true },
    { "filter": "LAST YEAR", "kind": "date", "value": "2025-12-31 23:00:00", "matches": true },
    { "filter": "NEXT YEAR", "kind": "date", "value": "2027-03-01 00:00:00", "matches": true },
    { "filter": "2026", "kind": "date", "value": "2026-05-05 00:00:00", "matches": true, "why": "four digits is a year" },
    { "filter": "2026", "kind": "date", "value": "2025-05-05 00:00:00", "matches": false },
    { "filter": "2026-08", "kind": "date", "value": "2026-08-30 23:00:00", "matches": true, "why": "and this is a month" },
    { "filter": "2026-08", "kind": "date", "value": "2026-09-01 00:00:00", "matches": false },
    { "filter": "2026-08-23", "kind": "date", "value": "2026-08-23 23:59:00", "matches": true, "why": "a day is the whole day" },
    { "filter": "2026-08-23", "kind": "date", "value": "2026-08-24 00:00:00", "matches": false },
    { "filter": ">=2026-08-23", "kind": "date", "value": "2026-08-24 00:00:00", "matches": true },
    { "filter": "<2026-08-23", "kind": "date", "value": "2026-08-22 12:00:00", "matches": true },
    { "filter": "NOT NULL", "kind": "date", "value": "2026-08-23 09:00:00", "matches": true },
    { "filter": "TODAY,YESTERDAY", "kind": "date", "value": "2026-08-22 10:00:00", "matches": true },

    { "filter": "", "kind": "text", "value": "Adam", "matches": true, "why": "nothing typed filters nothing" },
    { "filter": "   ", "kind": "text", "value": "Adam", "matches": true }
  ]
}
