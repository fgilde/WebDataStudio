<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Set by the release workflow. A desktop build stores its data next to the binary and
       opens a browser on start; the container build does neither. -->
  <ItemGroup Condition="'$(WdsDesktop)' == 'true'">
    <RuntimeHostConfigurationOption Include="Wds.Desktop" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Google.Cloud.Storage.V1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="ClickHouse.Client" />
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="MiniExcel" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <!-- Only build the SPA for Release; Debug and test builds stay fast and node-free. -->
  <Target Name="BuildSpa" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm install" WorkingDirectory="../../web" />
    <Exec Command="npm run build" WorkingDirectory="../../web" />
    <ItemGroup>
      <SpaFiles Include="../../web/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(SpaFiles)" DestinationFolder="wwwroot/%(RecursiveDir)" />
  </Target>

</Project>
