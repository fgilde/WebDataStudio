<Project>

  <!-- One version for everything the repository builds. The patch number is the CI run number, so
       it counts up without anybody editing a file; a local build stays 1.1.0-dev, which is how you
       tell a hand-built binary from a published one. The commit rides in the informational version,
       because "is the image running the fix I just pushed" is otherwise unanswerable from the
       studio itself. -->
  <PropertyGroup>
    <!-- The SDK otherwise appends the source revision to whatever we set, which turns a readable
         "1.1.42+abc1234" into "1.1.42+abc1234.<40 hex>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <WdsBuild Condition="'$(WdsBuild)' == ''">0</WdsBuild>
    <WdsCommit Condition="'$(WdsCommit)' == ''">local</WdsCommit>

    <!-- A release is built from a tag, and then the tag is the version: v1.1.0 has to produce
         1.1.0, not 1.1.<whatever the run number happened to be>. Without this the download said one
         thing and the image it was built from said another. -->
    <VersionPrefix Condition="'$(WdsVersion)' != ''">$(WdsVersion)</VersionPrefix>
    <VersionPrefix Condition="'$(WdsVersion)' == ''">1.1.$(WdsBuild)</VersionPrefix>
    <VersionSuffix Condition="'$(WdsVersion)' == '' AND '$(WdsBuild)' == '0'">dev</VersionSuffix>
    <InformationalVersion Condition="'$(WdsVersion)' != ''">$(WdsVersion)+$(WdsCommit)</InformationalVersion>
    <InformationalVersion Condition="'$(WdsVersion)' == '' AND '$(WdsBuild)' == '0'">1.1.0-dev+$(WdsCommit)</InformationalVersion>
    <InformationalVersion Condition="'$(WdsVersion)' == '' AND '$(WdsBuild)' != '0'">1.1.$(WdsBuild)+$(WdsCommit)</InformationalVersion>
  </PropertyGroup>

</Project>
